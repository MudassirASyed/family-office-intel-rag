NEWSAPI_KEY=your_newsapi_key_here
SEC_USER_AGENT=Your Name your_email@example.com
GROQ_API_KEY=your_groq_key_here

# Free, no card required: https://dashboard.cohere.com/api-keys
# Used for embeddings (hosted, so the API process doesn't need to load
# a local model - see retrieval/vectorstore.py for why).
COHERE_API_KEY=your_cohere_key_here

# Optional - only needed if the frontend and API aren't both on localhost
# (e.g. once each is deployed separately).
# API_BASE_URL=http://localhost:8000
